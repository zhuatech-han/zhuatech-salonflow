# Fill unique strong passwords. ADMIN_PASSWORD: 12–72 characters, uppercase/lowercase/digits.
MYSQL_ROOT_PASSWORD=
DATABASE_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Learning demo data is fictional; disable on an empty production database.
SEED_DEMO=false
WEB_PORT=8100
BIND_ADDRESS=127.0.0.1
# Enable only behind an HTTPS reverse proxy.
COOKIE_SECURE=false

# Optional external MySQL URL uses jdbc:mariadb://; require sslMode=verify-full and a trusted CA outside the isolated Compose network.
# DATABASE_URL=
# DATABASE_USER=salonflow

# Optional SMTP: no messages leave the system while SMTP_HOST / SMTP_FROM are blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
REMINDERS_ENABLED=true
